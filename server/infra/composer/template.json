						"POST",
						"PUT",
						"PATCH",
						"DELETE",
						"OPTIONS",
						"HEAD"
					],
					"AllowOrigins": [
						"http://localhost:5173",
						"https://dev.example.com"
					],
					"MaxAge": 86400
				},
				"Name": "elytra-dev-api",
				"ProtocolType": "HTTP",
				"Tags": {
					"Project": "elytra",
					"Stage": "dev",
					"composer:used-by": {
						"Ref": "Distribution"
					}
				}
			}
		},
		"HttpApiDefaultStage": {
			"Type": "AWS::ApiGatewayV2::Stage",
			"Properties": {
				"ApiId": {
					"Ref": "HttpApi"
				},
				"AutoDeploy": true,
				"DefaultRouteSettings": {
					"ThrottlingBurstLimit": 200,
					"ThrottlingRateLimit": 100
				},
				"StageName": "$default",
				"Tags": {
					"Project": "elytra",
					"Stage": "dev"
				}
			}
		},
		"PublicRouteIntegration": {
			"Type": "AWS::ApiGatewayV2::Integration",
			"Properties": {
				"ApiId": {
					"Ref": "HttpApi"
				},
				"IntegrationType": "AWS_PROXY",
				"IntegrationUri": {
					"Fn::GetAtt": [
						"Function",
						"Arn"
					]
				},
				"PayloadFormatVersion": "2.0"
			}
		},
		"PublicRouteIntegrationPermission": {
			"Type": "AWS::Lambda::Permission",
			"Properties": {
				"Action": "lambda:InvokeFunction",
				"FunctionName": {
					"Fn::GetAtt": [
						"Function",
						"Arn"
					]
				},
				"Principal": "apigateway.amazonaws.com",
				"SourceArn": {
					"Fn::Join": [
						"",
						[
							"arn:aws:execute-api:us-east-1:123456789012:",
							{
								"Ref": "HttpApi"
							},
							"/*/*/api/public/{proxy+}"
						]
					]
				}
			}
		},
		"PublicRoute": {
			"Type": "AWS::ApiGatewayV2::Route",
			"Properties": {
				"ApiId": {
					"Ref": "HttpApi"
				},
				"AuthorizationType": "NONE",
				"RouteKey": "ANY /api/public/{proxy+}",
				"Target": {
					"Fn::Join": [
						"",
						[
							"integrations/",
							{
								"Ref": "PublicRouteIntegration"
							}
						]
					]
				}
			}
		},
		"PrivateRouteIntegrationPermission": {
			"Type": "AWS::Lambda::Permission",
			"Properties": {
				"Action": "lambda:InvokeFunction",
				"FunctionName": {
					"Fn::GetAtt": [
						"Function",
						"Arn"
					]
				},
				"Principal": "apigateway.amazonaws.com",
				"SourceArn": {
					"Fn::Join": [
						"",
						[
							"arn:aws:execute-api:us-east-1:123456789012:",
							{
								"Ref": "HttpApi"
							},
							"/*/*/api/private/{proxy+}"
						]
					]
				}
			}
		},
		"PrivateRoute": {
			"Type": "AWS::ApiGatewayV2::Route",
			"Properties": {
				"ApiId": {
					"Ref": "HttpApi"
				},
				"AuthorizationType": "JWT",
				"AuthorizerId": {
					"Ref": "HttpApiCognitoAuthorizer"
				},
				"RouteKey": "ANY /api/private/{proxy+}",
