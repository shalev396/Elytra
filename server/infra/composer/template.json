{
	"AWSTemplateFormatVersion": "2010-09-09",
	"Description": "Elytra (dev): CloudFront, S3, HTTP API + Lambda, Cognito, SES",
	"Metadata": {
		"AWS::Composer::Groups": {
			"Edge": {
				"Label": "Edge",
				"Members": [
					"EmailIdentity",
					"DkimRecord1",
					"DkimRecord2",
					"DkimRecord3",
					"VerificationLogGroup",
					"VerificationFunctionServiceRole",
					"VerificationWaitHandle4fe83d68",
					"DomainVerified4fe83d68",
					"Certificate",
					"OriginAccessControl",
					"SpaRewrite",
					"Distribution",
					"AliasRecord"
				]
			},
			"Api": {
				"Label": "Api",
				"Members": [
					"HttpApi"
				]
			},
			"Compute": {
				"Label": "Compute",
				"Members": [
					"DependenciesLayer",
					"CodebaseLayer",
					"LogGroup",
					"FunctionServiceRole"
				]
			},
			"Storage": {
				"Label": "Storage",
				"Members": [
					"ClientBucket",
					"AssetsBucket"
				]
			},
			"Auth": {
				"Label": "Auth",
				"Members": [
					"UserPool",
					"UserPoolClient"
				]
			}
		}
	},
	"Parameters": {
		"DatabaseUrl": {
			"Type": "String",
			"Description": "DATABASE_URL connection string. Passed at deploy time; never stored in the template.",
			"MinLength": 1,
			"NoEcho": true
		}
	},
	"Mappings": {
		"AWSCloudFrontPartitionHostedZoneIdMap": {
			"aws": {
				"zoneId": "Z2FDTNDATAQYW2"
			},
			"aws-cn": {
				"zoneId": "Z3RFFRIM2A3IF5"
			}
		}
	},
	"Resources": {
		"ClientBucket": {
			"Type": "AWS::S3::Bucket",
			"Properties": {
				"BucketEncryption": {
					"ServerSideEncryptionConfiguration": [
						{
							"ServerSideEncryptionByDefault": {
								"SSEAlgorithm": "AES256"
							}
						}
					]
				},
				"BucketName": {
					"Fn::Join": [
						"",
						[
							"dev.example.com"
						]
					]
				},
				"PublicAccessBlockConfiguration": {
					"BlockPublicAcls": true,
					"BlockPublicPolicy": true,
					"IgnorePublicAcls": true,
					"RestrictPublicBuckets": true
				},
				"Tags": [
					{
						"Key": "Project",
						"Value": "elytra"
					},
					{
						"Key": "Stage",
						"Value": "dev"
					}
				]
			},
			"UpdateReplacePolicy": "Delete",
			"DeletionPolicy": "Delete"
		},
		"ClientBucketPolicy": {
			"Type": "AWS::S3::BucketPolicy",
			"Properties": {
				"Bucket": {
					"Ref": "ClientBucket"
				},
				"PolicyDocument": {
					"Statement": [
						{
							"Action": "s3:*",
							"Condition": {
								"Bool": {
									"aws:SecureTransport": "false"
								}
							},
							"Effect": "Deny",
							"Principal": {
								"AWS": "*"
							},
							"Resource": [
								{
									"Fn::GetAtt": [
										"ClientBucket",
										"Arn"
									]
								},
								{
									"Fn::Join": [
										"",
										[
											{
												"Fn::GetAtt": [
													"ClientBucket",
													"Arn"
												]
											},
											"/*"
										]
									]
								}
							]
						},
						{
							"Action": [
								"s3:GetObject",
								"s3:ListBucket"
							],
							"Condition": {
								"StringEquals": {
									"AWS:SourceArn": {
										"Fn::Join": [
											"",
											[
												"arn:",
												{
													"Ref": "AWS::Partition"
												},
												":cloudfront::",
												{
													"Ref": "AWS::AccountId"
												},
												":distribution/",
												{
													"Ref": "Distribution"
												}
											]
										]
									}
								}
							},
							"Effect": "Allow",
							"Principal": {
								"Service": "cloudfront.amazonaws.com"
							},
							"Resource": [
								{
									"Fn::GetAtt": [
										"ClientBucket",
										"Arn"
									]
								},
								{
									"Fn::Join": [
										"",
										[
											{
												"Fn::GetAtt": [
													"ClientBucket",
													"Arn"
												]
											},
											"/*"
										]
									]
								}
							]
						}
					],
					"Version": "2012-10-17"
				}
			}
		},
		"AssetsBucket": {
			"Type": "AWS::S3::Bucket",
			"Properties": {
				"BucketEncryption": {
					"ServerSideEncryptionConfiguration": [
						{
							"ServerSideEncryptionByDefault": {
								"SSEAlgorithm": "AES256"
							}
						}
					]
				},
				"BucketName": {
					"Fn::Join": [
						"",
						[
							"dev.example.com-assets"
						]
					]
				},
				"CorsConfiguration": {
					"CorsRules": [
						{
							"AllowedHeaders": [
								"*"
							],
							"AllowedMethods": [
								"GET",
								"HEAD",
								"POST"
							],
							"AllowedOrigins": [
								"http://localhost:5173",
								"https://dev.example.com"
							],
							"ExposedHeaders": [
								"ETag"
							],
							"MaxAge": 3600
						}
					]
				},
				"LifecycleConfiguration": {
					"Rules": [
						{
							"Id": "DeleteOldVersions",
							"NoncurrentVersionExpiration": {
								"NoncurrentDays": 30
							},
							"Status": "Enabled"
						},
						{
							"ExpirationInDays": 1,
							"Id": "DeleteExportZips",
							"Prefix": "tmp/exports/",
							"Status": "Enabled"
						},
						{
							"ExpirationInDays": 1,
							"Id": "DeleteStagedUploads",
							"Prefix": "tmp/staging/",
							"Status": "Enabled"
						}
					]
				},
				"PublicAccessBlockConfiguration": {
					"BlockPublicAcls": true,
					"BlockPublicPolicy": true,
					"IgnorePublicAcls": true,
					"RestrictPublicBuckets": true
				},
				"Tags": [
					{
						"Key": "Project",
						"Value": "elytra"
					},
					{
						"Key": "Stage",
						"Value": "dev"
					}
				],
				"VersioningConfiguration": {
					"Status": "Enabled"
				}
			},
			"UpdateReplacePolicy": "Delete",
			"DeletionPolicy": "Delete"
		},
		"AssetsBucketPolicy": {
			"Type": "AWS::S3::BucketPolicy",
			"Properties": {
				"Bucket": {
					"Ref": "AssetsBucket"
				},
				"PolicyDocument": {
					"Statement": [
						{
							"Action": "s3:*",
							"Condition": {
								"Bool": {
									"aws:SecureTransport": "false"
								}
							},
							"Effect": "Deny",
							"Principal": {
								"AWS": "*"
							},
							"Resource": [
								{
									"Fn::GetAtt": [
										"AssetsBucket",
										"Arn"
									]
								},
								{
									"Fn::Join": [
										"",
										[
											{
												"Fn::GetAtt": [
													"AssetsBucket",
													"Arn"
												]
											},
											"/*"
										]
									]
								}
							]
						},
						{
							"Action": "s3:GetObject",
							"Condition": {
								"StringEquals": {
									"AWS:SourceArn": {
										"Fn::Join": [
											"",
											[
												"arn:",
												{
													"Ref": "AWS::Partition"
												},
												":cloudfront::",
												{
													"Ref": "AWS::AccountId"
												},
												":distribution/",
												{
													"Ref": "Distribution"
												}
											]
										]
									}
								}
							},
							"Effect": "Allow",
							"Principal": {
								"Service": "cloudfront.amazonaws.com"
							},
							"Resource": {
								"Fn::Join": [
									"",
									[
										{
											"Fn::GetAtt": [
												"AssetsBucket",
												"Arn"
											]
										},
										"/*"
									]
								]
							}
						}
					],
					"Version": "2012-10-17"
				}
			}
		},
		"EmailIdentity": {
			"Type": "AWS::SES::EmailIdentity",
			"Properties": {
				"DkimSigningAttributes": {
					"NextSigningKeyLength": "RSA_2048_BIT"
				},
				"EmailIdentity": "dev.example.com",
				"Tags": [
					{
						"Key": "Project",
						"Value": "elytra"
					},
					{
						"Key": "Stage",
						"Value": "dev"
					}
				]
			}
		},
		"DkimRecord1": {
			"Type": "AWS::Route53::RecordSet",
			"Properties": {
				"HostedZoneId": "Z0000000000000FIXTURE",
				"Name": {
					"Fn::Join": [
						"",
						[
							{
								"Fn::GetAtt": [
									"EmailIdentity",
									"DkimDNSTokenName1"
								]
							},
							"."
						]
					]
				},
				"ResourceRecords": [
					{
						"Fn::GetAtt": [
							"EmailIdentity",
							"DkimDNSTokenValue1"
						]
					}
				],
				"TTL": "300",
				"Type": "CNAME"
			}
		},
		"DkimRecord2": {
			"Type": "AWS::Route53::RecordSet",
			"Properties": {
				"HostedZoneId": "Z0000000000000FIXTURE",
				"Name": {
					"Fn::Join": [
						"",
						[
							{
								"Fn::GetAtt": [
									"EmailIdentity",
									"DkimDNSTokenName2"
								]
							},
							"."
						]
					]
				},
				"ResourceRecords": [
					{
						"Fn::GetAtt": [
							"EmailIdentity",
							"DkimDNSTokenValue2"
						]
					}
				],
				"TTL": "300",
				"Type": "CNAME"
			}
		},
		"DkimRecord3": {
			"Type": "AWS::Route53::RecordSet",
			"Properties": {
				"HostedZoneId": "Z0000000000000FIXTURE",
				"Name": {
					"Fn::Join": [
						"",
						[
							{
								"Fn::GetAtt": [
									"EmailIdentity",
									"DkimDNSTokenName3"
								]
							},
							"."
						]
					]
				},
				"ResourceRecords": [
					{
						"Fn::GetAtt": [
							"EmailIdentity",
							"DkimDNSTokenValue3"
						]
					}
				],
				"TTL": "300",
				"Type": "CNAME"
			}
		},
		"VerificationLogGroup": {
			"Type": "AWS::Logs::LogGroup",
			"Properties": {
				"LogGroupName": "/aws/lambda/elytra-dev-ses-verification",
				"RetentionInDays": 30,
				"Tags": [
					{
						"Key": "Project",
						"Value": "elytra"
					},
					{
						"Key": "Stage",
						"Value": "dev"
					}
				]
			},
			"UpdateReplacePolicy": "Delete",
			"DeletionPolicy": "Delete"
		},
		"VerificationFunctionServiceRole": {
			"Type": "AWS::IAM::Role",
			"Properties": {
				"AssumeRolePolicyDocument": {
					"Statement": [
						{
							"Action": "sts:AssumeRole",
							"Effect": "Allow",
							"Principal": {
								"Service": "lambda.amazonaws.com"
							}
						}
					],
					"Version": "2012-10-17"
				},
				"ManagedPolicyArns": [
					{
						"Fn::Join": [
							"",
							[
								"arn:",
								{
									"Ref": "AWS::Partition"
								},
								":iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
							]
						]
					}
				],
				"Tags": [
					{
						"Key": "Project",
						"Value": "elytra"
					},
					{
						"Key": "Stage",
						"Value": "dev"
					}
				]
			}
		},
		"ServiceRoleDefaultPolicy": {
			"Type": "AWS::IAM::Policy",
			"Properties": {
				"PolicyDocument": {
					"Statement": [
						{
							"Action": "ses:GetEmailIdentity",
							"Effect": "Allow",
							"Resource": "arn:aws:ses:us-east-1:123456789012:identity/dev.example.com"
						},
						{
							"Action": "lambda:InvokeFunction",
							"Effect": "Allow",
							"Resource": "arn:aws:lambda:us-east-1:123456789012:function:elytra-dev-ses-verification"
						}
					],
					"Version": "2012-10-17"
				},
				"PolicyName": "EmailVerificationFunctionServiceRoleDefaultPolicy3B1FBDEB",
				"Roles": [
					{
						"Ref": "VerificationFunctionServiceRole"
					}
				]
			}
		},
		"VerificationFunction": {
			"Type": "AWS::Lambda::Function",
			"Properties": {
				"Architectures": [
					"arm64"
				],
				"Code": {
					"S3Bucket": "cdk-hnb659fds-assets-123456789012-us-east-1",
					"S3Key": "asset.zip"
				},
				"Description": "Deploy-time wait until SES has verified DOMAIN_NAME",
				"FunctionName": "elytra-dev-ses-verification",
				"Handler": "index.handler",
				"LoggingConfig": {
					"LogGroup": {
						"Ref": "VerificationLogGroup"
					}
				},
				"MemorySize": 256,
				"Role": {
					"Fn::GetAtt": [
						"VerificationFunctionServiceRole",
						"Arn"
					]
				},
				"Runtime": "nodejs24.x",
				"Tags": [
					{
						"Key": "Project",
						"Value": "elytra"
					},
					{
						"Key": "Stage",
						"Value": "dev"
					}
				],
				"Timeout": 900
			},
			"DependsOn": [
				"ServiceRoleDefaultPolicy",
				"VerificationFunctionServiceRole"
			]
		},
		"VerificationWaitHandle4fe83d68": {
			"Type": "AWS::CloudFormation::WaitConditionHandle"
		},
		"VerificationCheck": {
			"Type": "Custom::SesDomainVerification",
			"Properties": {
				"ServiceToken": {
					"Fn::GetAtt": [
						"VerificationFunction",
						"Arn"
					]
				},
				"ServiceTimeout": "300",
				"DomainName": "dev.example.com",
				"WaitHandleUrl": {
					"Ref": "VerificationWaitHandle4fe83d68"
				}
			},
			"DependsOn": [
				"DkimRecord1",
				"DkimRecord2",
				"DkimRecord3",
				"EmailIdentity"
			],
			"UpdateReplacePolicy": "Delete",
			"DeletionPolicy": "Delete"
		},
		"DomainVerified4fe83d68": {
			"Type": "AWS::CloudFormation::WaitCondition",
			"Properties": {
				"Count": 1,
				"Handle": {
					"Ref": "VerificationWaitHandle4fe83d68"
				},
				"Timeout": "43200"
			},
			"DependsOn": [
				"VerificationCheck"
			]
		},
		"HttpApi": {
			"Type": "AWS::ApiGatewayV2::Api",
