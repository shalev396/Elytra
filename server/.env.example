# Repository secrets
AWS_ACCOUNT_ID="123456789012"
CERTIFICATE_ARN="" # optional
WAF_WEB_ACL_ARN="" # optional

# Repository variables
AWS_ROLE_NAME="github-actions-deploy"
AWS_REGION="us-east-1" # optional

# Environment secrets
DATABASE_URL="postgres://user:password@host:5432/db"
# MongoDB Atlas with IAM auth, no password (docs/infrastructure.md):
# DATABASE_URL="mongodb+srv://cluster.example.mongodb.net/db?authSource=%24external&authMechanism=MONGODB-AWS&retryWrites=true&w=majority"

# Environment variables
DOMAIN_NAME="dev.example.com"
