{
  "name": "elytra-server",
  "version": "1.0.0",
  "description": "Elytra Serverless Backend",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "serverless offline --stage dev --param local=true",
    "qa": "serverless offline --stage qa --param local=true",
    "prod": "serverless offline --stage prod --param local=true",
    "build": "tsc",
    "lint": "eslint .",
    "deploy:dev": "serverless deploy --stage dev",
    "deploy:qa": "serverless deploy --stage qa",
    "deploy:prod": "serverless deploy --stage prod",
    "test:local": "postman collection run \"../postman/collections/Elytra API\" --environment \"../postman/environments/Elytra Local.environment.yaml\" ",
    "test:qa": "postman collection run \"../postman/collections/Elytra API\" --environment \"../postman/environments/Elytra QA.environment.yaml\" "
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1000.0",
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/client-ses": "^3.1000.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.1",
    "fflate": "^0.8.2",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "mongoose": "^8.14.1",
    "multer": "^2.1.1",
    "pg": "^8.16.2",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "serverless-http": "^4.0.0",
    "uuid": "^14.0.2"
  },
  "overrides": {
    "fast-xml-parser": ">=5.7.0",
    "serialize-javascript": ">=7.0.3",
    "jose": ">=5.0.0",
    "node-forge": ">=1.3.2",
    "qs": ">=6.16.0",
    "lodash": ">=4.17.24",
    "@hapi/content": ">=6.0.2",
    "brace-expansion": "^5.0.9",
    "minimatch": "^10.2.4",
    "glob": "^13.0.6",
    "uuid": "^14.0.2",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/aws-lambda": "^8.10.158",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.3",
    "@types/pg": "^8.16.0",
    "@types/uuid": "^10.0.0",
    "dotenv": "^17.3.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "postman-cli": "^1.27.0",
    "serverless-esbuild": "^1.57.2",
    "serverless-offline": "^14.4.0",
    "serverless-offline-watcher": "^1.1.0",
    "serverless-prune-plugin": "^2.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.39.1"
  }
}
