{
  "name": "elytra-server",
  "version": "1.0.0",
  "description": "Elytra backend: Express API on one AWS Lambda, infrastructure in AWS CDK",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/local.ts --stage dev",
    "qa": "tsx watch src/local.ts --stage qa",
    "prod": "tsx watch src/local.ts --stage prod",
    "start:local": "tsx src/local.ts",
    "build": "tsc -p tsconfig.json && tsc -p infra/tsconfig.json",
    "lint": "eslint .",
    "test:infra": "node --import tsx --test infra/test/*.test.ts",
    "test:unit": "node --import tsx --test \"src/**/*.test.ts\"",
    "build:layers": "tsx scripts/build-layers.ts",
    "verify:layers": "tsx scripts/verify-layers.ts",
    "synth": "cdk synth -c stage=dev -c fixture=true",
    "synth:composer": "tsx scripts/composer-template.ts",
    "deploy:backend": "tsx scripts/deploy-backend.ts",
    "deploy:frontend": "tsx scripts/deploy-frontend.ts",
    "test:local": "cd .. && postman collection run \"postman/collections/Elytra API\" --environment \"postman/environments/Elytra Local.environment.yaml\" --working-dir .",
    "test:qa": "cd .. && postman collection run \"postman/collections/Elytra API\" --environment \"postman/environments/Elytra QA.environment.yaml\" --working-dir ."
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1135.0",
    "@aws-sdk/client-s3": "^3.1135.0",
    "@aws-sdk/client-ses": "^3.1135.0",
    "@aws-sdk/s3-presigned-post": "^3.1135.0",
    "@aws-sdk/s3-request-presigner": "^3.1135.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.1",
    "fflate": "^0.8.3",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "mongoose": "^8.24.4",
    "pg": "^8.16.2",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "serverless-http": "^4.0.0"
  },
  "overrides": {
    "jose": "^5.10.0",
    "qs": ">=6.16.0",
    "lodash": ">=4.17.24",
    "brace-expansion": "^5.0.9",
    "minimatch": "^10.2.4",
    "tsx": "^4.23.13",
    "sequelize": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.1135.0",
    "@aws-sdk/client-cloudfront": "^3.1135.0",
    "@aws-sdk/client-cost-explorer": "^3.1135.0",
    "@aws-sdk/client-lambda": "^3.1135.0",
    "@aws-sdk/client-route-53": "^3.1135.0",
    "@eslint/js": "^9.39.5",
    "@types/aws-lambda": "^8.10.158",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.0.3",
    "@types/pg": "^8.16.0",
    "aws-cdk": "^2.1142.0",
    "aws-cdk-lib": "^2.270.0",
    "cdk-nag": "^3.0.2",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^16.3.0",
    "postman-cli": "^1.27.0",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0"
  }
}
