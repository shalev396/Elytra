{
  "name": "elytra-server",
  "version": "1.0.0",
  "description": "Elytra backend: Express API on one AWS Lambda, infrastructure in AWS CDK",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/local.ts --stage dev",
    "qa": "tsx watch src/local.ts --stage qa",
    "prod": "tsx watch src/local.ts --stage prod",
    "start:local": "tsx src/local.ts",
    "build": "tsc -p tsconfig.json && tsc -p infra/tsconfig.json",
    "lint": "eslint .",
    "test:infra": "node --import tsx --test infra/test/*.test.ts",
    "build:layers": "tsx scripts/build-layers.ts",
    "verify:layers": "tsx scripts/verify-layers.ts",
    "synth": "cdk synth -c stage=dev -c fixture=true",
    "synth:composer": "tsx scripts/composer-template.ts",
    "deploy:backend": "tsx scripts/deploy-backend.ts",
    "deploy:frontend": "tsx scripts/deploy-frontend.ts",
    "test:local": "postman collection run \"../postman/collections/Elytra API\" --environment \"../postman/environments/Elytra Local.environment.yaml\" ",
    "test:qa": "postman collection run \"../postman/collections/Elytra API\" --environment \"../postman/environments/Elytra QA.environment.yaml\" "
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1000.0",
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/client-ses": "^3.1000.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.1",
    "fflate": "^0.8.2",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "mongoose": "^8.14.1",
    "multer": "^2.1.1",
    "pg": "^8.16.2",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "serverless-http": "^4.0.0",
    "uuid": "^14.0.2"
  },
  "overrides": {
    "fast-xml-parser": ">=5.7.0",
    "serialize-javascript": ">=7.0.3",
    "jose": ">=5.0.0",
    "node-forge": ">=1.3.2",
    "qs": ">=6.16.0",
    "lodash": ">=4.17.24",
    "@hapi/content": ">=6.0.2",
    "brace-expansion": "^5.0.9",
    "minimatch": "^10.2.4",
    "glob": "^13.0.6",
    "uuid": "^14.0.2",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.1131.0",
    "@aws-sdk/client-cloudfront": "^3.1131.0",
    "@aws-sdk/client-cost-explorer": "^3.1131.0",
    "@aws-sdk/client-lambda": "^3.1131.0",
    "@aws-sdk/client-route-53": "^3.1131.0",
    "@eslint/js": "^9.33.0",
    "@types/aws-lambda": "^8.10.158",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.3",
    "@types/pg": "^8.16.0",
    "aws-cdk": "^2.1141.0",
    "aws-cdk-lib": "^2.269.0",
    "cdk-nag": "^3.0.2",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "postman-cli": "^1.27.0",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.39.1"
  }
}
