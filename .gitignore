*node_modules
*dist

# Server build artifacts (esbuild layers in server/.build, CDK cloud assembly)
# server/infra/composer/template.json is committed (regenerated by the pre-commit hook).
*build/
*cdk.out

# CDK context cache: never commit lookups (account, zone ids). The hosted zone is resolved at deploy time.
*cdk.context.json

# Environment files (secrets)
*.env.dev
*.env.qa
*.env.prod
*.env.local

# Test artifacts (contains tokens)
**exported.postman_environment.json

# Local Postman environment (user copy with baseUrl/secrets); use qa.template.json as reference
**/postman/environments/*.postman_environment.json

# Postman CLI test results (CI)
postman-results.xml

# Playwright E2E artifacts
*artifacts
*translations.json

# Python venv
*.venv
*__pycache__
*.DS_Store
