#!/bin/sh
# Pre-commit: format and lint the staged files only, and keep the Infrastructure Composer drawing
# in sync when infra code changes. Type checks and builds run in CI (_lint-build.yml).
set -e

# File lists below are one path per line; split on newlines only (some paths contain spaces).
IFS='
'

# 1. Staged files (deleted files left out)
FILES=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$FILES" ]; then
  exit 0
fi

# 2. Prettier formats them and the result is staged.
#    It skips files in .gitignore / .prettierignore and file types it does not know.
#    Note: this re-stages whole files, so partially staged hunks get committed too.
npx prettier --write --ignore-unknown --no-error-on-unmatched-pattern $FILES
git add $FILES

# 3. ESLint checks the staged code of each package with that package's own config.
CLIENT_FILES=$(echo "$FILES" | grep -E '^client/.+\.(js|jsx|ts|tsx)$' | sed 's|^client/||')
SERVER_FILES=$(echo "$FILES" | grep -E '^server/.+\.(js|ts)$' | sed 's|^server/||')

if [ -n "$CLIENT_FILES" ]; then
  (cd client && npx eslint --max-warnings 0 --no-warn-ignored $CLIENT_FILES)
fi
if [ -n "$SERVER_FILES" ]; then
  (cd server && npx eslint --max-warnings 0 --no-warn-ignored $SERVER_FILES)
fi

# 4. Infra changed: regenerate the committed Infrastructure Composer drawing (no AWS access
#    needed) and stage it. CI's test:infra fails when the drawing is stale.
if echo "$FILES" | grep -q '^server/infra/'; then
  (cd server && npm run synth:composer)
  git add server/infra/composer/template.json
fi
